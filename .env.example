# Copy to .env and fill in values. Never commit .env.
#
# Environments (see markdowns/DEV_SETUP.md):
#   - One .env file; comment which block is ACTIVE (develop vs production).
#   - ACTIVE: develop → dev SUPABASE_* + DATABASE_URL for migrations
#   - Production keys stay commented locally; Railway main uses prod vars in dashboard
#
# Variable names match pydantic-settings defaults (UPPER_SNAKE from field names).

# App
# DEBUG=false
# When true, failed Google/Microsoft token checks return the underlying error in
# the HTTP detail string and log with tracebacks (use only locally).

# Supabase
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres (for scripts/run_migrations.py only — database password from Supabase dashboard)
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Or: SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
# Bucket must exist in Supabase Storage (default name below).
# SUPABASE_STORAGE_BUCKET=cv-uploads

# Auth / API
# API_SECRET_KEY=
# JWT_SECRET=
# JWT_REFRESH_SECRET=
# ACCESS_TOKEN_EXPIRES_MINUTES=15
# REFRESH_TOKEN_EXPIRES_DAYS=7
# GOOGLE_CLIENT_ID=
# MICROSOFT_CLIENT_ID=
# Comma-separated emails allowed to sign in (empty = built-in beta list in code)
# AUTH_EMAIL_ALLOWLIST=b.hamid0210@gmail.com,alias.wardakmd@gmail.com

# Anthropic — required for the 6-agent CV pipeline
# ANTHROPIC_API_KEY=

# CORS — comma-separated frontend origins (required on Railway when using credentials)
# Local only: CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Dev example: CORS_ORIGINS=https://your-ui.up.railway.app,http://localhost:5173

# Metering — credits (1 credit = $1 by default)
# METER_CREDIT_USD=1.0
# METER_PIPELINE_RUN_USD=2.0
# METER_REVISION_USD=0.20
# METER_INITIAL_GRANT_CREDITS=20
